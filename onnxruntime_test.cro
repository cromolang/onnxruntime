// The tests of the package: cromo test onnxruntime.cro, in this folder. The model of
// testdata is y = Relu(x * W + b) and scores = Softmax(y), with x of 1 by 4; the numbers
// expected are those that ONNX Runtime gives from Python for the same model.

bool near(f32 a, f32 b) {
    f32 d = a - b
    ret d < 0.0001 && d > -0.0001
}

[[test]]
void theVersion() {
    assert(version().len() >= 5)
    assert(version().startsWith("1."))
}

[[test]]
void theNames() {
    Session model = Session(embed("testdata/linear.onnx"))
    assert(model.inputNames().len() == 1 && model.inputNames()[0] == "x")
    assert(model.outputNames().len() == 2)
    assert(model.outputNames()[0] == "y" && model.outputNames()[1] == "scores")
}

[[test]]
void aRun() {
    Session model = Session(embed("testdata/linear.onnx"))
    list<f32> x = [1.0, 2.0, 3.0, 4.0]
    list<Tensor> out = model.run([Tensor([1, 4], x)])
    assert(out.len() == 2)
    assert(out[0].shape.len() == 2 && out[0].shape[0] == 1 && out[0].shape[1] == 3)
    assert(near(out[0].data[0], 4.85) && near(out[0].data[1], 3.8) && near(out[0].data[2], 4.55))
    assert(near(out[1].data[0], 0.47829586) && near(out[1].data[1], 0.16737379) && near(out[1].data[2], 0.3543304))
}

[[test]]
void manyRuns() {
    Session model = Session(embed("testdata/linear.onnx"))
    for (i64 i = 0; i < 200; i++) {
        list<f32> x = [f32(i), 0.0, 0.0, 0.0]
        list<Tensor> out = model.run([Tensor([1, 4], x)])
        assert(near(out[0].data[0], 0.5 * f32(i) + 0.1))  // the first column of W and of b; never below 0 here
    }
}

[[test]]
void theRelu() {
    Session model = Session(embed("testdata/linear.onnx"))
    list<f32> x = [-10.0, 0.0, 0.0, 0.0]
    list<Tensor> out = model.run([Tensor([1, 4], x)])
    assert(out[0].data[0] == 0)  // -5 + 0.1, cut at 0
    assert(near(out[0].data[1], 9.8))
}

[[test]]
void notAModel() {
    bool refused = false
    try {
        Session model = Session("this is not a model".bytes())
    } catch (Error e) {
        refused = e.message().startsWith("ONNX Runtime: ")
    }
    assert(refused)
}

[[test]]
void aWrongShape() {
    Session model = Session(embed("testdata/linear.onnx"))
    bool refused = false
    try {
        list<f32> x = [1.0, 2.0, 3.0]
        model.run([Tensor([1, 3], x)])
    } catch (Error e) {
        refused = e.message().startsWith("ONNX Runtime: ")
    }
    assert(refused)
}

[[test]]
void theInputsCounted() {
    Session model = Session(embed("testdata/linear.onnx"))
    bool refused = false
    try {
        list<Tensor> none
        model.run(none)
    } catch (Error e) {
        refused = e.message().startsWith("the model has 1 inputs")
    }
    assert(refused)
}
